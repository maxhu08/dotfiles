# dotfile management and core terminal tools
brew "stow"
brew "git"
brew "gh"
brew "ripgrep"
brew "fzf"
brew "neovim"
brew "tmux"

# shell and utilities used by the fish/zsh configurations
brew "fish"
brew "eza"
brew "tree"
brew "zoxide"

# terminal and fonts
