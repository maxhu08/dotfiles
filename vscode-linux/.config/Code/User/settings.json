{
  // editor
  "editor.accessibilitySupport": "off",
  "editor.cursorBlinking": "blink",
  "editor.cursorSmoothCaretAnimation": "off", // "on" | "off"
  "editor.cursorStyle": "line",
  "editor.detectIndentation": false,
  "editor.fontFamily": "Jetbrains Mono",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": false,
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  "editor.tabSize": 2,
  "editor.unicodeHighlight.invisibleCharacters": true,

  // diff editor
  "diffEditor.codeLens": true,
  "diffEditor.ignoreTrimWhitespace": true,

  // languages and overrides
  "[latex]": {
    "editor.inlineSuggest.enabled": false,
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100
  },
  "html.format.contentUnformatted": "",

  // files and explorer
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.exclude": {
    "**/*.meta": true
  },

  // window and workbench
  "window.restoreWindows": "none",
  "window.titleBarStyle": "custom",
  "window.zoomLevel": 2,
  "workbench.colorTheme": "Darker Modern Tweaked",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.list.smoothScrolling": true,
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,

  // terminal
  "terminal.integrated.enableVisualBell": false,
  "terminal.integrated.fontFamily": "Jetbrains Mono, DejaVu Math TeX Gyre",
  "terminal.integrated.gpuAcceleration": "auto",
  "terminal.integrated.initialHint": false,
  "terminal.integrated.smoothScrolling": false,

  // git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "always",

  // accessibility and screencast
  "accessibility.signalOptions.volume": 0,
  "accessibility.signals.terminalBell": {
    "sound": "off"
  },
  "screencastMode.fontSize": 48,
  "screencastMode.mouseIndicatorColor": "#00000000",

  // chat and settings sync
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.titleBar.signIn.enabled": false,
  "settingsSync.ignoredSettings": [],

  // extensions: formatting and language tools
  "cmake.configureOnOpen": false,
  "latex-workshop.formatting.latex": "tex-fmt",
  "latex-workshop.formatting.tex-fmt.args": ["--wraplen", "100", "--tabsize", "2"],
  "latex-workshop.formatting.tex-fmt.path": "tex-fmt",
  "latex-workshop.latex.autoBuild.run": "onSave",

  // extensions: vim
  "vim.insertModeKeyBindings": [
    {
      // vim quick normal mode
      "before": ["k", "j"],
      "after": ["<Esc>"]
    },
    {
      // search files
      "before": ["<C-p>"],
      "commands": ["workbench.action.quickOpen"]
    }
  ],
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      // wrapped line fix
      "before": ["j"],
      "after": ["g", "j"]
    },
    {
      // wrapped line fix
      "before": ["k"],
      "after": ["g", "k"]
    },
    {
      // wrapped line fix
      "before": ["0"],
      "after": ["g", "0"]
    },
    {
      // wrapped line fix
      "before": ["^"],
      "after": ["g", "^"]
    },
    {
      // wrapped line fix
      "before": ["$"],
      "after": ["g", "$"]
    },
    {
      // vim move lines
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"]
    },
    {
      // vim move lines
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"]
    },
    {
      // search files
      "before": ["<C-p>"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      // search files (with leader)
      "before": ["<leader>", "<leader>"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      // toggle sidebar
      "before": ["<leader>", "b"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    // leap plugin find word globally
    {
      "before": ["<leader>", "s"],
      "commands": ["leap.find"]
    }
  ],
  "vim.useSystemClipboard": true,

  // extensions: other
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "redhat.telemetry.enabled": false,
  "svg.preview.mode": "img"
}
