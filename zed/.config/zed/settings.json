// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Agent and integrations
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-luna",
      "enable_thinking": true,
      "effort": "high",
    },
    "tool_permissions": {
      "default": "allow",
    },
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "write_paths": [
        {
          "requested": "/Users/mh/.config/zed",
          "resolved": "/Users/mh/.config/zed",
        },
      ],
      "network_hosts": ["zed.dev", "api.github.com", "raw.githubusercontent.com", "codeload.github.com", "github.com"],
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "new_window",

  // Editor behavior and navigation
  "base_keymap": "VSCode",
  "cursor_blink": true,
  "cursor_shape": "bar",
  "edit_predictions": {
    "provider": "none",
  },
  "format_on_save": "on",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  // Keep long lines unwrapped unless wrapping is enabled elsewhere.
  "preferred_line_length": 500,
  "sticky_scroll": {
    "enabled": false,
  },
  "tab_size": 2,
  "vim_mode": true,

  // Fonts and appearance
  "buffer_font_family": "Jetbrains Mono",
  "buffer_font_size": 15,
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "terminal": {
    "font_family": "Jetbrains Mono",
    "font_fallbacks": ["DejaVu Math TeX Gyre"],
  },
  "theme": {
    "mode": "dark",
    "light": "VSCode Light Modern Tweaked",
    "dark": "VSCode Darker Modern Tweaked",
  },
  "ui_font_size": 16,

  // Panels and tab bar
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false,
  },
  "status_bar": {
    "experimental.show": false,
  },
  "tab_bar": {
    // Hides the left/right navigation history arrows.
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "file_icons": true,
  },
}
